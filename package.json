{
  "name": "folder-renamer",
  "version": "1.0.0",
  "description": "Batch-renames folders to clean up dates, image counts, and known prefixes in messy photo and scan archives — as a CLI or a desktop app.",
  "homepage": "https://github.com/Karl-Horning/folder-renamer#readme",
  "bugs": {
    "url": "https://github.com/Karl-Horning/folder-renamer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karl-Horning/folder-renamer.git"
  },
  "license": "MIT",
  "author": "Karl Horning",
  "type": "module",
  "main": "electron/main.js",
  "productName": "Folder Renamer",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node ./src/app.js",
    "electron": "electron .",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.js"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "uk.co.karlhorning.folder-renamer",
    "productName": "Folder Renamer",
    "files": [
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "identity": null,
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
